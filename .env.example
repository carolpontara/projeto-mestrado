# ============================================================
# Avaliador de Artigos - Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit ---
STREAMLIT_PORT=8501
API_URL=http://api:8000/analyze

# --- LLM (Gemini) ---
API_KEY_LLM=your-google-genai-api-key-here

# --- spaCy model (downloaded at build time) ---
SPACY_MODEL=pt_core_news_sm
